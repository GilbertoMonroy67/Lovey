{
  "name": "noviazgo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de Noviazgo: Cloudflare Worker con Hono, D1 y R2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply noviazgo --local",
    "db:migrate:remote": "wrangler d1 migrations apply noviazgo --remote"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@vitest/runner": "~4.1.11",
    "@vitest/snapshot": "~4.1.11",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.148.0"
  }
}
